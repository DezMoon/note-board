{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["cypress", "node"],
    "strict": true,
    "useDefineForClassFields": false,
    "experimentalDecorators": true
  },
  "include": ["**/*.ts"]
}
