{
  "name": "note-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Frontend Engineer take-home challenge: a Lit web-component note board backed by a mocked API.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "cypress run --component",
    "test:e2e:open": "cypress open --component",
    "storybook": "storybook dev --port 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@lit/context": "1.1.6",
    "@lit/task": "1.0.3",
    "@open-wc/lit-helpers": "0.7.0",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-link": "3.29.2",
    "@tiptap/extension-placeholder": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "dompurify": "3.4.13",
    "lit": "3.3.3",
    "sortablejs": "1.15.7"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.6",
    "@storybook/addon-docs": "10.5.6",
    "@storybook/web-components": "10.5.6",
    "@storybook/web-components-vite": "10.5.6",
    "@types/node": "26.1.2",
    "@types/sortablejs": "1.15.9",
    "cypress": "15.20.0",
    "cypress-lit": "0.0.8",
    "cypress-real-events": "1.15.0",
    "happy-dom": "20.11.1",
    "msw": "2.15.0",
    "storybook": "10.5.6",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vite-bundle-analyzer": "1.3.9",
    "vitest": "4.1.10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}